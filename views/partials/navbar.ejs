<!-- Enhanced Navigation Bar with Logo -->
<nav class="bg-nepali-blue text-white shadow-lg sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <!-- Logo Section -->
            <div class="flex items-center">
                <a href="/" class="flex items-center space-x-2 hover:opacity-80 transition-opacity">
                    <img src="/images/nepfood-logo.svg" alt="NepFood Logo - Authentic Nepali Meal Kits" class="h-10 w-10 rounded-full bg-white p-1 logo-hover">
                    <span class="text-2xl font-bold text-white">NepFood</span>
                </a>
            </div>
            
            <!-- Desktop Navigation Links -->
            <div class="hidden md:block">
                <div class="ml-10 flex items-baseline space-x-6">
                    <a href="/" class="nav-link hover:bg-himalayan px-3 py-2 rounded-md text-sm font-medium transition-colors <%= (typeof currentPage !== 'undefined' && currentPage === 'home') ? 'bg-himalayan' : '' %>">
                        Home
                    </a>
                    <a href="/on-the-menu" class="nav-link hover:bg-himalayan px-3 py-2 rounded-md text-sm font-medium transition-colors <%= (typeof currentPage !== 'undefined' && currentPage === 'menu') ? 'bg-himalayan' : '' %>">
                        On The Menu
                    </a>
                </div>
            </div>
            
            <!-- User Authentication Section -->
            <div class="flex items-center space-x-4">
                <% if (user) { %>
                    <!-- Logged in user -->
                    <div class="hidden md:flex items-center space-x-3">
                        <span class="text-nepali-blue-100 text-sm">Welcome, <span class="font-semibold"><%= user.name %></span>!</span>
                        <form action="/logout" method="POST" class="inline">
                            <button type="submit" class="bg-red-400 hover:bg-red-500 px-4 py-2 rounded-md text-sm font-medium transition-colors shadow-sm">
                                Logout
                            </button>
                        </form>
                    </div>
                <% } else { %>
                    <!-- Guest user -->
                    <div class="hidden md:flex items-center space-x-3">
                        <a href="/log-in" class="bg-himalayan hover:bg-himalayan-600 px-4 py-2 rounded-md text-sm font-medium transition-colors text-white shadow-sm hover-magnetic">
                            Login
                        </a>
                        <a href="/sign-up" class="bg-saffron-500 hover:bg-saffron-600 px-4 py-2 rounded-md text-sm font-medium transition-colors text-white shadow-sm hover-magnetic glow-on-hover">
                            Sign Up
                        </a>
                    </div>
                <% } %>
                
                <!-- Mobile menu button -->
                <div class="md:hidden">
                    <button type="button" class="mobile-menu-button bg-nepali-blue-700 inline-flex items-center justify-center p-2 rounded-md text-nepali-blue-100 hover:text-white hover:bg-nepali-blue-600 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white transition-colors">
                        <span class="sr-only">Open main menu</span>
                        <!-- Hamburger icon -->
                        <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile menu (hidden by default) -->
    <div class="md:hidden mobile-menu hidden">
        <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 bg-nepali-blue-700">
            <a href="/" class="block hover:bg-nepali-blue-600 px-3 py-2 rounded-md text-base font-medium transition-colors">Home</a>
            <a href="/on-the-menu" class="block hover:bg-nepali-blue-600 px-3 py-2 rounded-md text-base font-medium transition-colors">On The Menu</a>
            
            <% if (user) { %>
                <div class="border-t border-nepali-blue-600 pt-4 pb-3">
                    <div class="px-3 py-2">
                        <div class="text-base font-medium text-white">Welcome, <%= user.name %>!</div>
                    </div>
                    <form action="/logout" method="POST" class="px-3">
                        <button type="submit" class="w-full text-left bg-red-400 hover:bg-red-500 px-3 py-2 rounded-md text-base font-medium transition-colors">
                            Logout
                        </button>
                    </form>
                </div>
            <% } else { %>
                <div class="border-t border-nepali-blue-600 pt-4 pb-3 space-y-1">
                    <a href="/log-in" class="block bg-himalayan hover:bg-himalayan-600 mx-3 px-3 py-2 rounded-md text-base font-medium transition-colors">
                        Login
                    </a>
                    <a href="/sign-up" class="block bg-saffron-500 hover:bg-saffron-600 mx-3 px-3 py-2 rounded-md text-base font-medium transition-colors">
                        Sign Up
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</nav>

<!-- Mobile menu toggle script -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const mobileMenuButton = document.querySelector('.mobile-menu-button');
        const mobileMenu = document.querySelector('.mobile-menu');
        
        if (mobileMenuButton && mobileMenu) {
            mobileMenuButton.addEventListener('click', function() {
                mobileMenu.classList.toggle('hidden');
            });
        }
    });
</script>