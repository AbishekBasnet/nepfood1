# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/nepfood
MONGODB_URI_ATLAS=mongodb+srv://username:password@cluster.mongodb.net/nepfood?retryWrites=true&w=majority

# Session Secret
SESSION_SECRET=nepfood-secret-key-2024-mongodb-integration

# Application Settings
PORT=8080
NODE_ENV=development

# MongoDB Atlas Settings (Optional)
DB_NAME=nepfood
CLUSTER_NAME=your-cluster-name

# Instructions:
# 1. For local MongoDB: Use MONGODB_URI
# 2. For MongoDB Atlas: Replace MONGODB_URI_ATLAS with your actual connection string
# 3. Never commit this file to version control with real credentials